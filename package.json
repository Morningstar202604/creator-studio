{
  "name": "creator-studio",
  "private": true,
  "version": "0.3.1",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r build && pnpm -r test",
    "verify": "pnpm -r build && pnpm -r typecheck && pnpm -r test && node scripts/security-audit.mjs && python scripts/check-contrast.py",
    "e2e": "node scripts/smoke-e2e.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "description": "本地优先的创作者 AI 制片台：选题、资料、脚本、分镜、包装、发布包、复盘一条流水线",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Morningstar202604/creator-studio.git"
  },
  "homepage": "https://github.com/Morningstar202604/creator-studio#readme",
  "bugs": {
    "url": "https://github.com/Morningstar202604/creator-studio/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "creator",
    "video",
    "local-first",
    "tauri",
    "electron-alternative",
    "content-creation",
    "workflow",
    "llm"
  ]
