{
  "name": "creator-studio",
  "private": true,
  "version": "0.18.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r build && pnpm -r test",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,ts}\" --max-warnings=0",
    "smoke:model": "pnpm -r build && node scripts/smoke-model.mjs --mode offline",
    "smoke:model:real": "pnpm -r build && node scripts/smoke-model.mjs --mode real",
    "test:postgres": "node scripts/postgres-test.mjs",
    "verify": "pnpm lint && pnpm -r build && pnpm -r typecheck && pnpm -r test && node scripts/smoke-model.mjs --mode offline && node scripts/security-audit.mjs && python scripts/check-contrast.py && node scripts/verify-versions.mjs && pnpm test:postgres",
    "e2e": "node scripts/smoke-e2e.mjs",
    "verify:versions": "node scripts/verify-versions.mjs"
  },
  "description": "Local-first AI production desk for solo creators: video, novels, podcasts, courses, with scenario packs, approval-gated tools and contract-checked artifacts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/badhope/creator-studio.git"
  },
  "homepage": "https://gitcode.com/badhope/creator-studio#readme",
  "bugs": {
    "url": "https://gitcode.com/badhope/creator-studio/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "creator",
    "video",
    "novel",
    "podcast",
    "local-first",
    "tauri",
    "workflow",
    "llm",
    "scenario-packs"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript-eslint": "8.72.1"
  }
}
