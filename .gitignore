.aqg/
node_modules/
dist/
*.log
.v2c/
out/
apps/desktop/src-tauri/target/
apps/desktop/dist/
apps/desktop/src-tauri/daemon-runtime/node_modules/
apps/desktop/src-tauri/daemon-runtime/package-lock.json
# Node runtime staged into the installer by scripts/install-daemon-deps.mjs
apps/desktop/src-tauri/daemon-runtime/node.exe
apps/desktop/src-tauri/daemon-runtime/node
workbuddy/
.workbuddy/
docs/screenshots-legacy/
*.tsbuildinfo
.env
.env.local
secrets.json
*.db
*.db-wal
*.db-shm
apps/desktop/src-tauri/gen/

# demo.py output (regenerated, not curated)
docs/screenshots-demo/

# scratch space used during development
.tmp/
# Root-level throwaway probes (`.tmp-*.mjs`, `.tmp-lint-probe.tsx`, ...). The
# directory rule above does not cover these, and five of them were committed by
# accident — they are not part of the product.
.tmp-*

# Python bytecode
__pycache__/
*.py[cod]

# Signing keys must never enter the repository. The updater's private key lives in
# .tmp/ during a build and in CI secrets; losing control of it means anyone can
# publish an update the app will trust.
*.key
*.pem
!scripts/**/*.key
