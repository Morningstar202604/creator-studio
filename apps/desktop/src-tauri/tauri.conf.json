{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CreatorStudio",
  "version": "0.18.0",
  "identifier": "app.creatorstudio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "稿台",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:7878; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "daemon-runtime/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "shortDescription": "稿台 · 本地优先的创作者 AI 制片台",
    "longDescription": "本地优先的创作者 AI 工作台：选题、资料、脚本、分镜、包装、发布包一站式完成，带审批、预算与审计，素材不出本机。",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5QTlGRjk5QkZDQkY2QTIKUldTaTlzdS9tZitwS1J1eTl6RWs2K0xwSWpPZHdldWU3WUFPU2RDc0RIQ0diVEdFekZ2SjRCTEsK",
      "endpoints": [
        "https://gitcode.com/badhope/creator-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
